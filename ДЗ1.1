#include <iostream>
using namespace std;

int main() {
    double S, V, rho, Cl, L;
    
    cout << "Введите площадь крыла (S): ";
    cin >> S;
    cout << "Введите скорость (V): ";
    cin >> V;
    cout << "Введите плотность воздуха (rho): ";
    cin >> rho;
    cout << "Введите коэффициент Cl: ";
    cin >> Cl;

    L = 0.5 * rho * V * V * S * Cl;

    cout << "Подъемная сила L = " << L << endl;

    return 0;
}
