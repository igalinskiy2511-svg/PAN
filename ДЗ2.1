#include <iostream>
#include <vector>
#include <iomanip>

int main() {
    double v0 = 50.0;
    double g = 9.8;
    double dt = 1.0;

    if (v0 <= 0.0) {
        std::cout << "Предупреждение: начальная скорость меньше или равна нулю.\n";
    }

    std::vector<double> times;
    std::vector<double> heights;
    
    int reserve_size = static_cast<int>(v0 * 2 / g / dt);
    times.reserve(reserve_size);
    heights.reserve(reserve_size);

    for (double t = 0.0; t <= 1000.0; t += dt) {
        double h = v0 * t - 0.5 * g * t * t;
        if (h < 0) {
            break;
        }
        times.push_back(t);
        heights.push_back(h);
    }

    std::cout << std::setw(10) << "t" << std::setw(15) << "h\n";
    for (size_t i = 0; i < times.size(); ++i) {
        std::cout << std::setw(10) << times[i] 
                  << std::setw(15) << std::fixed << std::setprecision(2) << heights[i] << "\n";
    }

    return 0;
}
