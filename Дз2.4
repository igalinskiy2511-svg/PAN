#include <iostream>
#include <vector>
#include <numeric>

int main() {
    double v0 = 50.0, g = 9.8, dt = 1.0;
    double t_max = v0 / g * 2;
    std::vector<double> velocities;

    for (double t = 0.0; t <= t_max; t += dt) {
        velocities.push_back(v0 - g * t);
    }

    if (velocities.empty()) {
        std::cout << "Вектор пуст\n";
        return 0;
    }

    double sum = std::accumulate(velocities.begin(), velocities.end(), 0.0);
    double avg = sum / velocities.size();

    std::cout << "Средняя скорость: " << avg << "\n";

    return 0;
}
