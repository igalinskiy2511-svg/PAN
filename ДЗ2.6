#include <iostream>
#include <vector>
#include <algorithm>

int main() {
    double v0 = 50.0, g = 9.8, dt = 1.0;
    std::vector<double> heights;

    for (double t = 0.0; ; t += dt) {
        double h = v0 * t - 0.5 * g * t * t;
        if (h < 0) break;
        heights.push_back(h);
    }

    auto new_end = std::remove_if(heights.begin(), heights.end(), [](double h) {
        return h < 10.0;
    });
    
    heights.erase(new_end, heights.end());

    for (double h : heights) {
        std::cout << h << " ";
    }
    std::cout << "\n";

    return 0;
}
