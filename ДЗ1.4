#include <iostream>
#include <cmath> // нужна для sqrt
using namespace std;

int main() {
    double h, ay, t;

    cout << "Введите ускорение ay (должно быть > 0): "; cin >> ay;
    if (ay <= 0) {
        cout << "Ошибка! Ускорение должно быть больше 0." << endl;
        return 0;
    }

    cout << "Введите высоту h (должна быть > 0): "; cin >> h;
    if (h <= 0) {
        cout << "Ошибка! Высота должна быть больше 0." << endl;
        return 0;
    }

    t = sqrt(2 * h / ay);

    cout << "Время набора высоты: " << t << endl;

    return 0;
}
